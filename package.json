{
  "name": "login-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm run start-json-server-1\" \" npm run start-json-server-2 \" \"ng serve\" ",
    "start-json-server-1": "json-server --watch users.json --port 3000",
    "start-json-server-2": "json-server --watch questions.json --port 3001",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "lint": "ng lint",
    "test:watch": "jest --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/cdk": "~19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/material": "~19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "^19.0.0",
    "@angular-devkit/build-angular": "^19.0.1",
    "@angular/cli": "^19.0.1",
    "@angular/compiler-cli": "^19.0.0",
    "@types/jest": "^29.5.14",
    "angular-eslint": "19.0.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jasmine-core": "~5.4.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.4.2",
    "json-server": "1.0.0-beta.3",
    "prettier": "^3.4.2",
    "prettier-eslint": "^16.3.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "8.18.0"
  }
}
